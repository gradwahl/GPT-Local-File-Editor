# HTTP server port used by npm run dev:http / start:http
PORT=3333

# Recommended: keep bound to localhost unless you know what you are doing.
HOST=127.0.0.1

# Required before exposing the HTTP endpoint through any tunnel.
MCP_LOCAL_TOKEN=change-me-to-a-long-random-secret

# Query-string token auth is OFF by default because URLs can leak through
# history, logs, tunnels, screenshots, and referrers. Enable only for local
# testing when bearer headers are awkward.
ALLOW_QUERY_TOKEN_AUTH=false

# HTTP MCP idle session cleanup. Default: 30 minutes.
MCP_SESSION_TTL_MS=1800000

# Safer workspace root for write_workspace_file/read_workspace_file.
WORKSPACE_ROOT=~/ChatGPT-editable

# Optional named workspaces for switch_workspace(name).
# Format: name=/absolute/path,name2=/absolute/path2
# WORKSPACE_ROOTS=mcp=C:\Users\Callum\Downloads\chatgpt-local-file-mcp,diablo=C:\Users\Callum\Downloads\Diablo 2 Open-Source
# DEFAULT_WORKSPACE=mcp

# Enables arbitrary absolute-path reads for read_any_file and list_any_dir.
# This can expose private files. Set to the phrase below to enable it.
ALLOW_RAW_READ_ANY_FILE=I_UNDERSTAND_THIS_CAN_READ_PRIVATE_FILES

# Enables the intentionally dangerous write_any_file(path, content) tool.
# Leave unset unless you really want arbitrary absolute-path writes.
# ALLOW_RAW_WRITE_ANY_FILE=I_UNDERSTAND_THIS_CAN_DESTROY_FILES

# Backups and audit log go here by default.
# CHATGPT_FILE_MCP_HOME=~/.chatgpt-local-file-mcp

# Optional backup cleanup policy. 0 means disabled.
BACKUP_RETENTION_DAYS=30
MAX_BACKUP_MB=1000

# Search performance tuning. ripgrep is used automatically when rg is on PATH.
# Set RIPGREP_PATH to the full rg.exe path if the MCP process cannot find rg on PATH.
# RIPGREP_PATH=C:\\Users\\Callum\\scoop\\shims\\rg.exe
# Set SEARCH_USE_RIPGREP=false to force the JavaScript fallback scanner.
SEARCH_USE_RIPGREP=true
# Uses rg --files for faster workspace file indexing when ripgrep is available.
SEARCH_USE_RIPGREP_FILES=true
SEARCH_CONCURRENCY=16
# Keep workspace indexes warm for repeated agent searches. Set 0 to disable.
SEARCH_INDEX_CACHE_TTL_MS=300000

# Write performance tuning. Defaults favor safety; disable only if you want
# faster writes and understand the tradeoff.
WRITE_CREATE_BACKUP_DEFAULT=true
WRITE_COMPUTE_SHA256=true

# Comma-separated origins accepted by HTTP mode.
# Use "*" only for local experiments, not production.
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
